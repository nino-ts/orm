{
    "$schema": "https://jsr.io/schema/config-file.v1.json",
    "name": "@ninots/orm",
    "version": "0.0.2",
    "exports": "./index.ts",
    "publish": {
        "include": [
            "src/**/*.ts",
            "index.ts",
            "README.md",
            "package.json",
            "jsr.json",
            "LICENSE",
            "jsr-shims/**/*.ts"
        ],
        "exclude": [
            "tests/**",
            "dist/**",
            "node_modules/**"
        ]
    },
    "license": "MIT",
    "imports": {
        "bun": "./jsr-shims/bun.ts",
        "bun:sqlite": "./jsr-shims/bun-sqlite.ts"
    }
}
